# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Server-Only, PRD 11.1 / E5)
SUPABASE_SERVICE_ROLE_KEY=

# Cron Scheduled Job Protection Secret (TimingSafeEqual)
CRON_SECRET=

# Resend API Key for Email Delivery
RESEND_API_KEY=

# Email Delivery Mode: 'sandbox' (default) or 'live'
EMAIL_MODE=sandbox

# Sandbox Test Recipient (Required when EMAIL_MODE=sandbox)
EMAIL_SANDBOX_TO=

# Verified Sender Email Address (Required when EMAIL_MODE=live)
EMAIL_FROM=

# Application Base URL (e.g. http://localhost:3000 or production domain)
APP_URL=
