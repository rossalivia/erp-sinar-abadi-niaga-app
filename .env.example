# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — ERP CV SINAR ABADI NIAGA
# Salin berkas ini menjadi .env.local untuk pengembangan lokal:
#   cp .env.example .env.local
# CATATAN: Berkas .env.local otomatis diabaikan oleh .gitignore dan TIDAK BOLEH
# di-commit ke repositori publik.
# ==============================================================================

# 1. Konfigurasi Basis Data Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service-Role Key (HANYA digunakan di server backend untuk cron / background task sistem):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Konfigurasi URL Aplikasi Publik (Opsional untuk webhook callback & email)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Integrasi Payment Gateway Mayar Sandbox
# Set MAYAR_MOCK=true untuk menggunakan mock offline tanpa panggilan jaringan
MAYAR_MOCK=true
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=sandbox_webhook_token_rahasia
MAYAR_BASE_URL=https://api.mayar.club/hl/v1

# 4. Layanan Pengiriman Email Notifikasi Stok Menipis (Resend)
RESEND_API_KEY=re_...
# Mode: 'sandbox' (mengirim email ke EMAIL_SANDBOX_TO) atau 'live' (mengirim ke staf riil)
EMAIL_MODE=sandbox
EMAIL_SANDBOX_TO=user@example.com
EMAIL_FROM=Peringatan Stok <onboarding@resend.dev>

# 5. Keamanan Penjadwalan Cron Harian (Netlify / Vercel Cron Trigger)
CRON_SECRET=rahasia-cron-super-aman-12345
